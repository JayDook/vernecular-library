{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "claim.schema.json",
 "title": "Evidence-graded claim",
 "type": "object",
 "required": [
  "id",
  "claim",
  "evidence_level",
  "citations",
  "confidence"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z_]+-[0-9]{3}$"
  },
  "topic": {
   "type": "string"
  },
  "claim": {
   "type": "string",
   "minLength": 10
  },
  "evidence_level": {
   "enum": [
    "documented",
    "inferred",
    "speculative"
   ]
  },
  "reasoning": {
   "type": "string",
   "description": "Required for inferred/speculative: why the evidence supports (or only weakly suggests) the claim"
  },
  "date": {
   "type": "string"
  },
  "period": {
   "type": "string"
  },
  "fiction_cited_as": {
   "const": "what_he_wrote",
   "description": "Must be present when any citation is to Verne's fiction: the fiction is evidence only of what he wrote, never of his beliefs"
  },
  "caveats": {
   "type": "string"
  },
  "citations": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "source_id",
     "location"
    ],
    "properties": {
     "source_id": {
      "type": "string",
      "pattern": "^(letter:[A-Za-z0-9_]+|[a-z0-9][a-z0-9-]*)$"
     },
     "location": {
      "type": "string"
     },
     "quote": {
      "type": "string"
     },
     "source_kind": {
      "enum": [
       "firsthand",
       "verne_own_words_reported",
       "secondary",
       "verne_text",
       "encyclopedia"
      ]
     },
     "char_offset": {
      "type": "integer",
      "description": "character offset of the quote in the stored text file"
     },
     "quote_type": {
      "enum": [
       "published_text",
       "machine_htr",
       "archival_description",
       "archival_transcription_unverified"
      ]
     }
    }
   }
  },
  "confidence": {
   "enum": [
    "high",
    "medium",
    "low"
   ]
  },
  "category": {
   "enum": [
    "humour",
    "disagreement",
    "emotional_reaction",
    "conversational_habit"
   ]
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "evidence_level": {
      "enum": [
       "inferred",
       "speculative"
      ]
     }
    }
   },
   "then": {
    "required": [
     "reasoning"
    ]
   }
  }
 ]
}