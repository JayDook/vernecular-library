{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "relationships.schema.json",
 "type": "object",
 "required": [
  "description",
  "records"
 ],
 "properties": {
  "description": {
   "type": "string"
  },
  "records": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "$ref": "claim.schema.json"
     },
     {
      "type": "object",
      "required": [
       "person",
       "relation"
      ],
      "properties": {
       "person": {
        "type": "string"
       },
       "relation": {
        "type": "string"
       }
      }
     }
    ]
   }
  }
 }
}